# --- App ---
APP_ENV=development            # development | test | production
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Database (PostgreSQL 16) ---
# Required: POSTGRES_PASSWORD
POSTGRES_USER=labellens
POSTGRES_PASSWORD=
POSTGRES_DB=labellens
# Only when running the backend outside Docker (PostgreSQL connection URL)
DATABASE_URL=

# --- Auth ---
# Required: JWT_SECRET, at least 32 characters
JWT_SECRET=
# Session length in minutes
JWT_TTL_MINUTES=480
COOKIE_SECURE=false            # must be true in production (HTTPS)
# Explicit list of browser origins allowed to call the API directly. '*' is refused.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# --- Extraction ---
# cached = replay saved outputs (no key, no cost); claude = call the Claude API.
EXTRACTION_PROVIDER=cached
EXTRACTION_MODEL=claude-opus-5-5
# Folder of saved outputs; real calls are added here so they can be replayed later.
EXTRACTION_CACHE_DIR=../data/extraction_cache
# Anthropic API key, only needed when EXTRACTION_PROVIDER=claude
EXTRACTION_API_KEY=

# --- Email (password reset links) ---
# Without SMTP_HOST no email is sent. Example for Gmail (needs an app password, see README).
# Start of the link inside the email: the address people use to open the app
APP_BASE_URL=http://localhost:8080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
# Your Gmail address
SMTP_USERNAME=
# App password from Google, never your normal password
SMTP_PASSWORD=
# Sender shown in the email; for Gmail use your own address
SMTP_FROM="LabelLens <your.address@gmail.com>"

# --- First admin (used by: python -m app.cli create-admin) ---
ADMIN_PASSWORD=
