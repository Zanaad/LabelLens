# --- App ---
APP_ENV=development            # development | test | production
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Database (PostgreSQL 16) ---
# Required: POSTGRES_PASSWORD
POSTGRES_USER=labellens
POSTGRES_PASSWORD=
POSTGRES_DB=labellens
# Only when running the backend outside Docker (PostgreSQL connection URL)
DATABASE_URL=

# --- Auth ---
# Required: JWT_SECRET, at least 32 characters
JWT_SECRET=
# Session length in minutes
JWT_TTL_MINUTES=480
COOKIE_SECURE=false            # must be true in production (HTTPS)
# Explicit list of browser origins allowed to call the API directly. '*' is refused.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# --- Extraction ---
# cached = replay saved outputs (no key, no cost).
EXTRACTION_PROVIDER=cached
EXTRACTION_MODEL=
EXTRACTION_API_KEY=

# --- First admin (used by: python -m app.cli create-admin) ---
ADMIN_PASSWORD=
